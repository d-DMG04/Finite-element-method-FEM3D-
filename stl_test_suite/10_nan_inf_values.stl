solid nan_inf
  facet normal 0.0 0.0 1.0
    outer loop
      vertex 0.0 0.0 0.0
      vertex 1.0 NaN 0.0
      vertex inf 0.0 0.0
    endloop
  endfacet
  facet normal 0.0 0.0 1.0
    outer loop
      vertex 0.0 0.0 0.0
      vertex 1.0 0.0 0.0
      vertex 0.0 1.0 0.0
    endloop
  endfacet
  facet normal nan nan nan
    outer loop
      vertex 2.0 2.0 2.0
      vertex 3.0 2.0 2.0
      vertex 2.5 3.0 2.0
    endloop
  endfacet
endsolid nan_inf
